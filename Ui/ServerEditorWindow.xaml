<ui:ThemedWindow x:Class="ClippedImageToPath.Ui.ServerEditorWindow"
        x:ClassModifier="internal"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <ui:ThemedWindow.Resources>
    <!-- The kit has no PasswordBox style yet; this mirrors its TextBox. -->
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,7,12,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
  </ui:ThemedWindow.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel LastChildFill="False">
        <Button x:Name="TestButton" DockPanel.Dock="Left" Content="Test connection" Click="Test_Click"/>
        <Button DockPanel.Dock="Right" Content="Cancel" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
      </DockPanel>
    </Border>
    <Grid Margin="22,20,22,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="128"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource FieldLabel}"/>
      <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
        <TextBox x:Name="NameBox" AutomationProperties.Name="Name"/>
        <TextBlock x:Name="NameError" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <TextBlock Grid.Row="1" Text="Protocol" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="ProtocolBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" AutomationProperties.Name="Protocol"
                SelectionChanged="Protocol_Changed">
        <ComboBoxItem Content="SFTP (SSH)"/>
        <ComboBoxItem Content="FTP (plain)"/>
        <ComboBoxItem Content="FTPS (explicit TLS)"/>
        <ComboBoxItem Content="FTPS (implicit TLS)"/>
      </ComboBox>

      <TextBlock Grid.Row="2" Text="Host" Style="{StaticResource FieldLabel}"/>
      <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
        <TextBox x:Name="HostBox" AutomationProperties.Name="Host"/>
        <TextBlock x:Name="HostError" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <TextBlock Grid.Row="3" Text="Port" Style="{StaticResource FieldLabel}"/>
      <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
        <TextBox x:Name="PortBox" Width="96" HorizontalAlignment="Left" AutomationProperties.Name="Port"/>
        <TextBlock x:Name="PortError" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <TextBlock Grid.Row="4" Text="User" Style="{StaticResource FieldLabel}"/>
      <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
        <TextBox x:Name="UserBox" AutomationProperties.Name="User"/>
        <TextBlock x:Name="UserError" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <TextBlock Grid.Row="5" Text="Password" Style="{StaticResource FieldLabel}"/>
      <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
        <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Password"/>
        <TextBlock x:Name="PasswordError" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <TextBlock Grid.Row="6" Text="Remote directory" Style="{StaticResource FieldLabel}"/>
      <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,12">
        <TextBox x:Name="DirectoryBox" AutomationProperties.Name="Remote directory"/>
        <TextBlock x:Name="DirectoryError" Style="{StaticResource ErrorText}" Margin="0,4,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <DockPanel Grid.Row="7" Grid.Column="1">
        <CheckBox x:Name="PassiveBox" DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" Margin="0,0,12,0"
                  AutomationProperties.Name="Use passive mode (FTP/FTPS)"/>
        <TextBlock x:Name="PassiveLabel" Text="Use passive mode (FTP/FTPS)" VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</ui:ThemedWindow>
