<ui:ThemedWindow x:Class="ClippedImageToPath.Ui.RemoteServersWindow"
        x:ClassModifier="internal"
        xmlns:ui="clr-namespace:AlexLV.WindowsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource KitWindow}"
        Title="Remote Servers" Width="620" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Footer}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
          <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
        <TextBlock x:Name="DirtyText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <DockPanel Margin="20,18">
      <StackPanel DockPanel.Dock="Right" Width="140" Margin="14,28,0,0">
        <Button x:Name="AddButton" Content="Add…" HorizontalAlignment="Stretch" Click="Add_Click"/>
        <Button x:Name="EditButton" Content="Edit…" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Edit_Click"/>
        <Button x:Name="RemoveButton" Content="Remove" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Remove_Click"/>
        <Button x:Name="ActiveButton" Content="Set as active" HorizontalAlignment="Stretch" Margin="0,22,0,0" Click="Active_Click"/>
        <Button x:Name="TestButton" Content="Test" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="Test_Click"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="The active server receives uploads. Double-click a server to edit it." Style="{StaticResource MutedText}"
                   FontSize="14" Margin="0,0,0,8"/>
        <Grid Height="300">
          <ListBox x:Name="List" AutomationProperties.Name="Remote servers"
                   MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown"/>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="No remote servers yet" Style="{StaticResource StrongText}" HorizontalAlignment="Center"/>
            <TextBlock Text="Add a server to upload saved images." Style="{StaticResource MutedText}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</ui:ThemedWindow>
